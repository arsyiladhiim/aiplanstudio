LARAVEL_URL=http://localhost:8000

# Sentry/GlitchTip DSN — DISABLED (service mati). Kosongkan untuk tetap nonaktif.
# Aktifkan lagi: uncomment service glitchtip di docker-compose.yml +
# route nginx + isi DSN, lalu build ulang web.
# Server-side (SSR/route handlers) uses internal Docker DNS
# SENTRY_DSN=
# Browser-side (leave empty to disable client-side capture)
# NEXT_PUBLIC_SENTRY_DSN=
