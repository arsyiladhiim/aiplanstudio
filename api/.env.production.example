APP_NAME="AI Planning Studio"
APP_ENV=production
# WAJIB: generate dengan `php artisan key:generate` — jangan pernah commit nilai asli
APP_KEY=
APP_DEBUG=false
# URL publik (https) — dipakai untuk generasi URL webhook & redirect
APP_URL=https://aiplanstudio.arsyiladm.my.id

# --- Database (dalam Docker, host = nama service `db`) ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=aistack
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# --- Session / Cookie ---
# Sesuaikan SESSION_DOMAIN dengan domain cookie (titik di depan agar subdomain ikut)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.arsyiladm.my.id
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true

# --- Sanctum SPA (domains yang dianggap first-party; tanpa ini semua API jadi 401) ---
SANCTUM_STATEFUL_DOMAINS=aiplanstudio.arsyiladm.my.id
FRONTEND_URL=https://aiplanstudio.arsyiladm.my.id

# --- Google OAuth ---
# Redirect URI terdaftar di Google Cloud Console: https://aiplanstudio.arsyiladm.my.id/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://aiplanstudio.arsyiladm.my.id/api/auth/google/callback

# --- Mail (SMTP) — WAJIB untuk pengiriman email reset password ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@arsyiladm.my.id
MAIL_FROM_NAME="AI Plan Studio"

# --- Redis (dipakai compose; cache/queue default database) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# --- Cache / Queue / Log ---
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_LEVEL=error
