# ============================================================================
# API Environment — Dokumentasi & Template
# ============================================================================
# Salin file ini menjadi `.env` lalu isi nilai di bawah.
#   cp .env.example .env
#
# CATATAN:
# - File ini HANYA dokumentasi template. Semua nilai placeholder/kosong.
# - JANGAN commit nilai asli (rahasia) ke git.
# - Untuk produksi: set APP_ENV=production, APP_DEBUG=false,
#   SESSION_SECURE_COOKIE=true, dan ganti URL lokal -> domain HTTPS publik.
# ============================================================================

# --- Aplikasi ---
APP_NAME="AI Planning Studio"
# local | production
APP_ENV=local
# WAJIB: generate dengan `php artisan key:generate` (jangan commit nilai asli)
APP_KEY=
# true saat development, false di produksi
APP_DEBUG=true
# URL publik yang diakses browser (dev: http://localhost:4197)
APP_URL=http://localhost:4197

# --- Database (PostgreSQL, host = nama service docker `db`) ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
# Nama DB (dev, sesuai POSTGRES_DB di root .env project)
DB_DATABASE=aiplanstudio
DB_USERNAME=postgres
DB_PASSWORD=

# --- Session / Cookie ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SAME_SITE=lax
SESSION_DOMAIN=localhost
# true jika HTTPS (produksi)
SESSION_SECURE_COOKIE=false

# --- Sanctum SPA (first-party domains; tanpa ini API jadi 401) ---
# Comma-separated. Dev: localhost,localhost:4197. Prod: domain HTTPS, tanpa https://
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:4197
FRONTEND_URL=http://localhost:4197

# --- Google OAuth (isi dari Google Cloud Console) ---
# Redirect URI terdaftar harus SAMA dengan GOOGLE_REDIRECT_URI di bawah.
#   Dev : http://localhost:4197/api/auth/google/callback
#   Prod: https://<domain>/api/auth/google/callback
# JavaScript origins (Google Console): http://localhost:4197 (dev) / https://<domain> (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4197/api/auth/google/callback

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Cache / Queue / Mail ---
CACHE_STORE=database
QUEUE_CONNECTION=database
# dev: `log` (tulis ke file, tidak kirim email). Prod: smtp.
MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@<domain>
# MAIL_FROM_NAME="AI Studio"

# --- Seeder (opsional; dipakai DatabaseSeeder) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Sentry/GlitchTip error monitoring — DISABLED (service mati). ---
# Aktifkan lagi: uncomment service glitchtip di docker-compose.yml +
# route nginx + isi DSN. Kosongkan untuk tetap nonaktif (SDK no-op).
# SENTRY_LARAVEL_DSN=
# SENTRY_ENVIRONMENT=local