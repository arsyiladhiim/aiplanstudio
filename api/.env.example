APP_NAME="AI Planning Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=aistack
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SAME_SITE=lax
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false

SANCTUM_STATEFUL_DOMAINS=localhost
FRONTEND_URL=http://localhost:3000

# Google OAuth (isi kredensial dari Google Cloud Console)
# Redirect URI yang terdaftar: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=aistack_redis_2024

# Docker Compose overrides (set di .env root project):
# POSTGRES_PASSWORD=postgres
# DB_PASSWORD=postgres
