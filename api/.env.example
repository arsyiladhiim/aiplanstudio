# ============================================================================
# API Environment — Dokumentasi & Template
# ============================================================================
# Salin file ini menjadi `.env` lalu isi nilai di bawah.
#   cp .env.example .env
#
# CATATAN:
# - File ini HANYA dokumentasi template. Semua nilai placeholder/kosong.
# - JANGAN commit nilai asli (rahasia) ke git.
# - Untuk produksi: set APP_ENV=production, APP_DEBUG=false,
#   SESSION_SECURE_COOKIE=true, dan ganti URL lokal -> domain HTTPS publik.
# - Arsitektur: direct routing (no BFF — see docs/25-bypass-bff.md).
#   Browser fetch langsung ke APP_URL, nginx di belakang Cloudflare Tunnel
#   yang handle TLS termination + defense-in-depth headers.
# ============================================================================

# --- Aplikasi ---
APP_NAME="AI Planning Studio"
# local | production
APP_ENV=local
# WAJIB: generate dengan `php artisan key:generate` (jangan commit nilai asli)
APP_KEY=
# true saat development, false di produksi
APP_DEBUG=true
# URL publik API (nginx di belakang Cloudflare Tunnel).
# Dev : http://localhost:8000 (port nginx_api direct — no BFF).
# Prod: https://api-<your-domain> (ganti saat deploy).
# TODO: ganti ke domain HTTPS publik saat deploy.
APP_URL=http://localhost:8000

# --- Database (PostgreSQL, host = nama service docker `db`) ---
DB_CONNECTION=pgsql
DB_HOST=aiplanstudio_db
DB_PORT=5432
# Nama DB (dev, sesuai POSTGRES_DB di root .env project)
DB_DATABASE=aiplanstudio
DB_USERNAME=postgres
DB_PASSWORD=

# --- Session / Cookie ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SAME_SITE=lax
# Dev : localhost (cookie tanpa dot prefix — hanya host ini)
# Prod: aiplanstudio.arsyiladm.my.id (HARUS subdomain app, bukan root .arsyiladm.my.id
#       agar session cookie tidak dibagi lintas subdomain lain di domain yang sama)
SESSION_DOMAIN=localhost
# true hanya jika HTTPS (produksi). Dev (http://localhost) → false.
SESSION_SECURE_COOKIE=false

# --- Sanctum SPA (first-party domains; tanpa ini API jadi 401) ---
# Comma-separated. Dev: localhost (Next.js frontend origin).
# Prod (no-BFF): tambahkan frontend public domain, misal SANCTUM_STATEFUL_DOMAINS=aiplanstudio.your-domain.com
# TODO: tambah frontend public domain saat deploy (see docs/25-bypass-bff.md).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000
# URL frontend (untuk link email reset password, OAuth redirect).
# Dev : http://localhost:3000 (Next.js direct).
# Prod: https://<your-frontend-domain>
# TODO: ganti ke frontend public domain saat deploy.
FRONTEND_URL=http://localhost:3000

# --- Google OAuth (isi dari Google Cloud Console) ---
# Redirect URI terdaftar harus SAMA dengan GOOGLE_REDIRECT_URI di bawah.
#   Dev : http://localhost:8000/api/auth/google/callback (nginx_api direct)
#   Prod: https://<api-domain>/api/auth/google/callback
# JavaScript origins (Google Console): http://localhost:3000 (dev) / https://<frontend-domain> (prod)
# TODO: ganti ke public API domain saat deploy.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Redis ---
REDIS_HOST=aiplanstudio_redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Cache / Queue / Mail ---
CACHE_STORE=database
QUEUE_CONNECTION=database
# dev: `log` (tulis ke file, tidak kirim email). Prod: smtp.
MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@<domain>
# MAIL_FROM_NAME="AI Studio"

# --- Seeder (opsional; dipakai DatabaseSeeder) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Sentry/GlitchTip error monitoring — DISABLED (service mati). ---
# Aktifkan lagi: uncomment service glitchtip di docker-compose.yml +
# route nginx + isi DSN. Kosongkan untuk tetap nonaktif (SDK no-op).
# SENTRY_LARAVEL_DSN=
# SENTRY_ENVIRONMENT=local